{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-script concordance claim",
  "type": "object",
  "required": [
    "claim_id",
    "source",
    "target",
    "relationship_type",
    "epistemic_status",
    "confidence",
    "provenance"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "relationship_type": {
      "enum": [
        "graphic_similarity",
        "historical_derivation",
        "phonetic_equivalence_proposed",
        "functional_equivalence",
        "encoding_unification",
        "numeric_identity"
      ]
    },
    "epistemic_status": {
      "enum": [
        "source_explicit",
        "project_derived",
        "needs_primary_verification"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "not_scored"
      ]
    },
    "proposed_value": {
      "type": [
        "string",
        "null"
      ]
    },
    "proponent": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
